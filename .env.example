# DeepSeek（必填，只在服务端使用）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# 可选：自建/代理地址，默认 https://api.deepseek.com/chat/completions
DEEPSEEK_BASE_URL=

# 数据库（可选；不填则页脚不显示统计，问答不受影响）
# Vercel 里添加 KV 后会自动注入下面两个变量
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 前端（可选）：后端与前端分开部署时，填后端域名，如 https://xxx.vercel.app
VITE_API_BASE=
